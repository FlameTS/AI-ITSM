@model IEnumerable<AIITSM.Web.Models._01_M1_IdentityAccess.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
}

<h2>User Management</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create User
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>

                <td>
                    @if (user.IsActive)
                    {
                        <span>Active</span>
                    }
                    else
                    {
                        <span>Inactive</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="ResetPassword"
                       asp-route-id="@user.Id"
                       class="btn btn-sm btn-secondary">
                        Reset Password
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>