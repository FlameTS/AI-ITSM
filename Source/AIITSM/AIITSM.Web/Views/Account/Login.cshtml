@model AIITSM.Web.Models._01_M1_IdentityAccess.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-container">

        <div class="login-brand-panel">

            <div>
                <h1>AI-ITSM</h1>

                <h4>AI-Powered IT Service Desk</h4>

                <p>
                    A centralized platform for intelligent incident
                    management, automated support workflows, and
                    role-based IT service operations.
                </p>
            </div>

            <div class="login-features">
                <p>✓ Secure role-based access</p>
                <p>✓ Intelligent incident management</p>
                <p>✓ AI-assisted support</p>
                <p>✓ Automated notifications & escalation</p>
            </div>

        </div>

        <div class="login-form-panel">

            <div class="login-form-wrapper">

                <div class="mb-4">
                    <h2 class="fw-bold">Welcome Back</h2>

                    <p class="text-muted">
                        Sign in to access your IT service desk.
                    </p>
                </div>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               class="form-control login-input"
                               placeholder="name@company.com" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Password"
                               class="form-label">
                            Password
                        </label>

                        <input asp-for="Password"
                               class="form-control login-input"
                               placeholder="Enter your password" />

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="form-check mb-4">

                        <input asp-for="RememberMe"
                               class="form-check-input" />

                        <label asp-for="RememberMe"
                               class="form-check-label">
                            Remember me
                        </label>

                    </div>

                    <button type="submit"
                            class="btn btn-dark w-100 login-button">
                        Sign In
                    </button>

                </form>

                <div class="login-security-message">
                    <small>
                        Access is restricted to authorized AI-ITSM users.
                    </small>
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}