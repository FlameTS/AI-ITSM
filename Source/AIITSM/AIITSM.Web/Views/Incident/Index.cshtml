@model IReadOnlyList<AIITSM.Application._02_M2_IncidentManagement.IncidentSummaryDto>

@{
    ViewData["Title"] = "My Incidents";
}

<div class="container mt-4">

    <h1>My Incidents</h1>

    <p class="text-muted">
        Incidents you have reported.
    </p>

    <a asp-controller="Incident" asp-action="Create" class="btn btn-primary mb-3">
        + Create Incident
    </a>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <hr />

    @if (!Model.Any())
    {
        <p>You haven't reported any incidents yet.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Incident #</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var incident in Model)
                {
                    <tr>
                        <td>@incident.IncidentNumber</td>
                        <td>@incident.Title</td>
                        <td>@incident.CategoryName</td>
                        <td>@incident.Priority</td>
                        <td>
                            <span class="badge bg-secondary">@incident.Status</span>
                        </td>
                        <td>@incident.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <a asp-controller="Incident" asp-action="Details" asp-route-id="@incident.IncidentId" class="btn btn-sm btn-outline-primary">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>
