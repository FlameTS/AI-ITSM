@{
    ViewData["Title"] = "AI Assistant";
}

<div class="container py-4" style="max-width: 700px;">
    <h2 class="mb-3">AI Assistant</h2>
    <div id="chat-window" class="border rounded p-3 mb-3 bg-white" style="height: 60vh; overflow-y: auto;"></div>

    <form id="chat-form" class="d-flex gap-2">
        <input type="text" id="chat-input" class="form-control" placeholder="Ask something..." autocomplete="off" required />
        <button type="submit" class="btn btn-primary">Send</button>
    </form>
</div>

<script>
    const chatWindow = document.getElementById('chat-window');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');

    let history = [];

    function renderMessage(role, text) {
        const wrapper = document.createElement('div');
        wrapper.className = 'mb-2 d-flex ' + (role === 'user' ? 'justify-content-end' : 'justify-content-start');

        const bubble = document.createElement('div');
        bubble.className = (role === 'user' ? 'bg-primary text-white' : 'bg-light') + ' rounded px-3 py-2';
        bubble.style.maxWidth = '75%';
        bubble.innerText = text;

        wrapper.appendChild(bubble);
        chatWindow.appendChild(wrapper);
        chatWindow.scrollTop = chatWindow.scrollHeight;
    }

    chatForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        const message = chatInput.value.trim();
        if (!message) return;

        history.push({ role: 'user', text: message });
        renderMessage('user', message);
        chatInput.value = '';

        const thinking = document.createElement('div');
        thinking.id = 'thinking-indicator';
        thinking.className = 'mb-2 text-muted fst-italic';
        thinking.innerText = 'Assistant is typing...';
        chatWindow.appendChild(thinking);
        chatWindow.scrollTop = chatWindow.scrollHeight;

        try {
            const response = await fetch('/Chat/SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(history)
            });

            document.getElementById('thinking-indicator')?.remove();

            if (!response.ok) {
                renderMessage('assistant', 'Something went wrong. Please try again.');
                return;
            }

            const data = await response.json();
            history.push({ role: 'assistant', text: data.reply });
            renderMessage('assistant', data.reply);
        } catch (err) {
            document.getElementById('thinking-indicator')?.remove();
            renderMessage('assistant', 'Something went wrong. Please try again.');
        }
    });
</script>