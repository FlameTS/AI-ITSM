@model IReadOnlyList<AIITSM.Application._04_M4_Administration.DTOs.CategoryDto>

@{
    ViewData["Title"] = "Category Management";
}

<h1>Category Management</h1>

<div class="mb-4">
    <h4>Create Category</h4>

    <form asp-controller="Administration"
          asp-action="CreateCategory"
          method="post">

        @Html.AntiForgeryToken()
        <div class="input-group">
            <input type="text"
                   name="categoryName"
                   class="form-control"
                   placeholder="Category name"
                   required
                   maxlength="100" />

            <button type="submit"
                    class="btn btn-primary">
                Add Category
            </button>
        </div>
    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Category ID</th>
            <th>Category Name</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.CategoryId</td>

                <td>
                    <form asp-controller="Administration"
                          asp-action="UpdateCategory"
                          method="post"
                          class="d-flex">

                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="categoryId"
                               value="@category.CategoryId" />

                        <input type="text"
                               name="categoryName"
                               value="@category.CategoryName"
                               class="form-control"
                               maxlength="100"
                               required />

                        <button type="submit"
                                class="btn btn-sm btn-secondary ms-2">
                            Update
                        </button>
                    </form>
                </td>

                <td>
                    <form asp-controller="Administration"
                          asp-action="DeleteCategory"
                          method="post">

                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="categoryId"
                               value="@category.CategoryId" />

                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Are you sure you want to delete this category?');">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
