@model AIITSM.Web.Models.AgentWorkflowModel

@{
    ViewData["Title"] = "Agent Workflow";
}

<div class="container mt-4">

    <h1>Agent Workflow</h1>

    <p class="text-muted">
        Incident assignment, status management and agent comments.
    </p>

    <hr />

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h4>Incident Details</h4>
        </div>

        <div class="card-body">

            <p>
                <strong>Incident ID:</strong>
                @Model.IncidentId
            </p>

            <p>
                <strong>Title:</strong>
                @Model.Title
            </p>

            <p>
                <strong>Description:</strong>
                @Model.Description
            </p>

            <p>
                <strong>Priority:</strong>
                @Model.Priority
            </p>

            <p>
                <strong>Status:</strong>
                @Model.Status
            </p>

            <p>
                <strong>Assigned Agent:</strong>
                @(Model.AssignedTo?.ToString() ?? "Not Assigned")
            </p>

            <p>
                <strong>Comment:</strong>
                @(Model.Comment ?? "No comments")
            </p>

        </div>
    </div>


    <!-- UPDATE STATUS -->

    <div class="card mb-4">
        <div class="card-header">
            <h4>Update Incident Status</h4>
        </div>

        <div class="card-body">

            <form asp-controller="AgentWorkflow"
                  asp-action="UpdateStatus"
                  method="post">

                <input type="hidden"
                       name="incidentId"
                       value="@Model.IncidentId" />

                <div class="mb-3">

                    <label class="form-label">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="Open"
                                selected="@(Model.Status == "Open")">
                            Open
                        </option>

                        <option value="In Progress"
                                selected="@(Model.Status == "In Progress")">
                            In Progress
                        </option>

                        <option value="Resolved"
                                selected="@(Model.Status == "Resolved")">
                            Resolved
                        </option>

                        <option value="Closed"
                                selected="@(Model.Status == "Closed")">
                            Closed
                        </option>

                    </select>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Update Status
                </button>

            </form>

        </div>
    </div>


    <!-- ASSIGN AGENT -->

    <div class="card mb-4">
        <div class="card-header">
            <h4>Assign Agent</h4>
        </div>

        <div class="card-body">

            <form asp-controller="AgentWorkflow"
                  asp-action="AssignAgent"
                  method="post">

                <input type="hidden"
                       name="incidentId"
                       value="@Model.IncidentId" />

                <div class="mb-3">

                    <label class="form-label">
                        Agent ID
                    </label>

                    <input type="number"
                           name="assignedTo"
                           class="form-control"
                           placeholder="Enter Agent ID"
                           value="@Model.AssignedTo" />

                </div>

                <button type="submit"
                        class="btn btn-success">
                    Assign Agent
                </button>

            </form>

        </div>
    </div>


    <!-- ADD COMMENT -->

    <div class="card mb-4">
        <div class="card-header">
            <h4>Add Comment</h4>
        </div>

        <div class="card-body">

            <form asp-controller="AgentWorkflow"
                  asp-action="AddComment"
                  method="post">

                <input type="hidden"
                       name="incidentId"
                       value="@Model.IncidentId" />

                <div class="mb-3">

                    <label class="form-label">
                        Comment
                    </label>

                    <textarea name="comment"
                              class="form-control"
                              rows="4"
                              placeholder="Enter incident comment"></textarea>

                </div>

                <button type="submit"
                        class="btn btn-secondary">
                    Add Comment
                </button>

            </form>

        </div>
    </div>

</div>